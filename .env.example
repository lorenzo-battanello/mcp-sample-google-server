GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI of the Google OAuth client
GOOGLE_REDIRECT_URI=http://localhost:5080/auth/callback
# Shared secret the client sends in X-Api-Key
MCP_API_KEY=
# Encrypted refresh tokens + Data Protection keys (keep out of git)
MCP_TOKEN_STORE_PATH=./data
# Optional hard cap for returned text (characters)
MCP_MAX_TEXT_CHARS=20000
ASPNETCORE_URLS=http://localhost:5080
